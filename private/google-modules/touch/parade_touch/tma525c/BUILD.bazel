)

ddk_module(
    name = "pt",
    srcs = [
        "mcu_touch.c",
        "mcu_touch.h",
        "pt_core.c",
        "pt_core.h",
        "pt_mt_common.c",
        "pt_regs.h",
    ],
    out = "pt.ko",
    conditional_srcs = {
        "CONFIG_TOUCHSCREEN_PARADE_MT_A": {
            True: [
                "pt_mta.c",
            ],
        },
        "CONFIG_TOUCHSCREEN_PARADE_MT_B": {
            True: [
                "pt_mtb.c",
            ],
        },
        "CONFIG_TOUCHSCREEN_PARADE_BUTTON": {
            True: [
                "pt_btn.c",
            ],
        },
        "CONFIG_TOUCHSCREEN_PARADE_PEN": {
            True: [
                "pt_pen.c",
            ],
        },
        "CONFIG_TOUCHSCREEN_PARADE_PROXIMITY": {
            True: [
                "pt_proximity.c",
            ],
        },
    },
    defconfig = "defconfig",
    kconfig = "Kconfig",
    kernel_build = "//private/google-modules/soc/msm:msm_kernel_build",
    local_defines = [
        "CONFIG_TOUCHSCREEN_PARADE_BINARY_FW_UPGRADE",
        "CONFIG_TOUCHSCREEN_PARADE_MANUAL_TTCONFIG_UPGRADE",
        "PT_PINCTRL_EN",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/soc/msm:__pkg__",
    ],
    deps = [
        "//private/google-modules/display/watch/mcu-offload/mcu_display",
        "//private/google-modules/soc/msm:mcu_transport_header",
        "//private/google-modules/wac/autobahn",
        "//private/msm-google:all_headers",
    ],
)

