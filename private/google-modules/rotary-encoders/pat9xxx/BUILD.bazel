load(
    "@kleaf//build/kernel/kleaf:kernel.bzl",
    "ddk_headers",
    "ddk_module",
)
load("//private/google-modules/soc/msm:bazel/constants.scl", "SOC_NAME")

ddk_headers(
    name = "headers",
    hdrs = glob([
        "*.h",
    ]),
    includes = ["."],
)

ddk_module(
    name = "pat9xxx",
    srcs = [
        "pat9xxx_core.c",
        "rsb_comms.c",
    ],
    out = "pat9xxx.ko",
    hdrs = ["headers"],
    defconfig = "defconfig",
    kconfig = "Kconfig",
    kernel_build = "//private/google-modules/soc/msm:msm_kernel_build",
    local_defines = [
        # do not sort
        "DYNAMIC_DEBUG_MODULE",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/soc:__subpackages__",
    ],
    deps = [
        "//private/google-modules/input/offload/i2c-arbitration:i2c_arbitration_interface",
        "//private/google-modules/input/offload/i2c-arbitration/mcu_transport",
        "//private/msm-google:all_headers",
        "//private/msm-google:{}_perf/drivers/soc/qcom/panel_event_notifier".format(SOC_NAME),
    ],
)
