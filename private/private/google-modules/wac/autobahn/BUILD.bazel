pkg_files(
    name = "abn_kunit_tests_pkg_files",
    srcs = [
        ":abn_msg_queue_tests",
        ":abn_nanohub_adapter_tests",
        ":abn_signal_in_tests",
        ":abn_signal_out_tests",
        ":abn_thread_notif_interf_tests",
        ":abn_timer_interf_tests",
        ":autobahn_checksum_tests",
        ":autobahn_fd_spi_transport_tests",
    ],
    strip_prefix = strip_prefix.files_only(),
)

pkg_install(
    name = "abn_kunit_tests_dist",
    srcs = [":abn_kunit_tests_pkg_files"],
    destdir = "out/abn_kunit",
)
