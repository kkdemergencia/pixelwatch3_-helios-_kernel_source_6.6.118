load("@kleaf//build/kernel/kleaf:kernel.bzl", "checkpatch", "ddk_module")

checkpatch(
    name = "checkpatch",
    checkpatch_pl = "@kleaf//common:scripts/checkpatch.pl",
)

ddk_module(
    name = "broadcom",
    srcs = [
        "nitrous.c",
    ],
    out = "nitrous.ko",
    kernel_build = "//private/google-modules/soc/msm:msm_kernel_build",
    local_defines = [
        # do not sort
        "DYNAMIC_DEBUG_MODULE",
    ],
    visibility = [
        "//private/devices/google:__subpackages__",
        "//private/google-modules/soc/msm:__pkg__",
    ],
    deps = [
        "//private/google-modules/bms:misc-headers",
        "//private/google-modules/bms/misc:logbuffer",
        "//private/msm-google:all_headers_aarch64",
    ],
)
