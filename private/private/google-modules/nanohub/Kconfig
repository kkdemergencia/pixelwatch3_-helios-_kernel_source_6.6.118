config NANOHUB
	tristate "Nanohub"
	select IIO
	help
	  Enable support for the nanohub sensorhub driver.

	  This driver supports the android nanohub sensorhub.

	  If in doubt, say N here.

if NANOHUB

config NANOHUB_SPI
	bool "Nanohub SPI"
	default y
	help
	  Enable nanohub SPI support.

	  If in doubt, say Y here.

config NANOHUB_BL_NXP
	bool "Nanohub NXP bootloader support"
	help
	  Enable nanohub NXP bootloader support.

	  If in doubt, say N here.

config NANOHUB_BL_ST
	bool "Nanohub STMicro bootloader support"
	help
	  Enable nanohub STMicro bootloader support.

	  If in doubt, say N here.

config NANOHUB_SPI_AMBIQ_HD
	bool "Nanohub SPI with Ambiq half-duplex SPI"
	help
	  Enable support for Ambiq half-duplex SPI being connected to this device

config NANOHUB_SPI_AMBIQ_FD
	bool "Nanohub SPI with Ambiq full-duplex SPI"
	help
	  Enable support for Ambiq full-duplex SPI being connected to this device

endif # NANOHUB
