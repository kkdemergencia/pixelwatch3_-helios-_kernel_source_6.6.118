    srcs = [
        "google-kamino.h",
        "google-kamino-core.c",
        "google-kamino-event-faker.c",
        "google-kamino-event-faker.h",
        "google-kamino-extcon.c",
        "google-kamino-extcon.h",
        "google-kamino-moisture-detect-mitigation.c",
        "google-kamino-moisture-detect-mitigation.h",
        "google-kamino-periodic-reauth.c",
        "google-kamino-periodic-reauth.h",
    ],
    out = "google-kamino.ko",
    kernel_build = "//private/google-modules/soc/msm:msm_kernel_build",
    local_defines = [
