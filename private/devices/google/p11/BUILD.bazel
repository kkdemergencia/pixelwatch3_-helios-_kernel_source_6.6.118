load(
    "@kleaf//build/kernel/kleaf:kernel.bzl",
    "checkpatch",
    "kernel_dtstree",
)
load(
    "//private/google-modules/soc/msm:bazel/pixel_watch_utils.bzl",
    "sw5100_pixel_watch_dist",
    "sw5100_pixel_watch_dtbo_image",
)
load(
    ":dt_overlays.scl",
    "P11_OVERLAYS",
)
load(
    ":modules.scl",
    "P11_VENDOR_DLKM_BLOCKLIST_MODULES",
    "P11_VENDOR_DLKM_MODULES",
    "P11_VENDOR_KERNEL_BOOT_MODULES",
    "P11_VENDOR_KERNEL_BOOT_RECOVERY_MODULES",
)

checkpatch(
    name = "checkpatch",
    checkpatch_pl = "@kleaf//common:scripts/checkpatch.pl",
)

kernel_dtstree(
    name = "p11.dt",
    srcs = glob(
        ["dts/**"],
    ) + [
        "//private/google-modules/soc/msm:sw5100.dt-bindings",
    ],
    makefile = "dts/Makefile",
)

sw5100_pixel_watch_dtbo_image(
    name = "p11_dtbo",
    dtb_overlays = P11_OVERLAYS,
    dtstree = ":p11.dt",
)

sw5100_pixel_watch_dist(
    name = "sw5100_p11_dist",
    device_name = "p11",
    device_vendor_dlkm_blocklist = P11_VENDOR_DLKM_BLOCKLIST_MODULES,
    device_vendor_dlkm_modules = P11_VENDOR_DLKM_MODULES,
    device_vendor_kernel_boot_modules = P11_VENDOR_KERNEL_BOOT_MODULES,
    device_vendor_kernel_boot_recovery_modules = P11_VENDOR_KERNEL_BOOT_RECOVERY_MODULES,
    dtbo_image = ":p11_dtbo",
)
